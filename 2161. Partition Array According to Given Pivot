/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* pivotArray(int* nums, int numsSize, int pivot, int* returnSize) {    
    int count = 0;
    int pi;
    int temp;

    *returnSize = numsSize;

    for(int i = 0; i < numsSize; i++) {
        if(nums[i] == pivot) {
            pi = i;
            i = numsSize;
        }
    } 

     do {
      count = 0;
      for(int i = 0; i < numsSize; i ++) {
        temp = nums[i];

        if (nums[i] == pivot && i > pi) {
            for(int j = i; j > pi; j--) {
                nums[j] = nums[j-1];
            }

            nums[pi++] = temp;
            count = 1;
         } else if (nums[i] < pivot && i > pi) {
            for(int j = i; j > pi; j--) {
                nums[j] = nums[j-1];
            }

            nums[pi] = temp;
            pi = pi + 1;
            count = 1;
         } else if (nums[i] > pivot && i < pi) {
            for(int j = i; j < numsSize-1; j++) {
                nums[j] = nums[j + 1];
            }

            nums[numsSize-1] = temp;
            pi = pi - 1;
            count = 1;
         }
      }
    } while(count);

    return nums;
}
